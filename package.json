{
  "name": "setup-vind",
  "version": "1.4.0",
  "description": "GitHub Action to provision Kubernetes clusters via vCluster Docker driver (vind)",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:post",
    "build:main": "esbuild src/main.ts --bundle --platform=node --target=node24 --outfile=dist/main/index.js --minify",
    "build:post": "esbuild src/post.ts --bundle --platform=node --target=node24 --outfile=dist/post/index.js --minify",
    "lint": "eslint '**/*.ts'",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loft-sh/setup-vind.git"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/glob": "^0.7.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.8.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.5.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jest": "^30.0.0",
    "globals": "^17.9.0",
    "ts-jest": "^29.1.4",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.66.0"
  }
}
